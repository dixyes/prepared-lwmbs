# syntax=docker/dockerfile

FROM quay.io/pypa/manylinux2014_x86_64:2026.10.25-1

LABEL maintainer="Yun Dou <dixyes@gmail.com>" \
    license="MulanPSL-2.0" \
    description="Image for using lwmbs - linux glibc x86_64 native"

ARG LWMBS_BRANCH=master
ARG LWMBS_REPO=https://github.com/dixyes/lwmbs.git

# CentOS 7 is EOL, pin a vault snapshot. NSC keeps a complete 7.9.2009 tree
ARG CENTOS_MIRROR=https://mirror.nsc.liu.se/centos-store/7.9.2009
# EPEL 7 is archived, zstd is only there
ARG EPEL_MIRROR=https://archives.fedoraproject.org/pub/archive/epel/7

ARG PHP_VERSION=8.5.12
ARG RE2C_VERSION=3.1
# the official x86_64 tarball requires glibc 2.28, this is the unofficial glibc 2.17 build
ARG NODE_VERSION=22.23.4

# Replace the EOL repositories with the pinned vault snapshot
RUN --mount=type=cache,id=lwmbs-centos7-x86_64,target=/var/cache/yum \
    set -xeo pipefail ; \
    rm -f /etc/yum.repos.d/*.repo ; \
    { \
        echo '[base]' ; \
        echo 'name=CentOS-7 - Base' ; \
        echo 'baseurl='"${CENTOS_MIRROR}"'/os/$basearch/' ; \
        echo 'enabled=1' ; \
        echo 'gpgcheck=1' ; \
        echo 'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7' ; \
        echo ; \
        echo '[updates]' ; \
        echo 'name=CentOS-7 - Updates' ; \
        echo 'baseurl='"${CENTOS_MIRROR}"'/updates/$basearch/' ; \
        echo 'enabled=1' ; \
        echo 'gpgcheck=1' ; \
        echo 'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7' ; \
        echo ; \
        echo '[extras]' ; \
        echo 'name=CentOS-7 - Extras' ; \
        echo 'baseurl='"${CENTOS_MIRROR}"'/extras/$basearch/' ; \
        echo 'enabled=1' ; \
        echo 'gpgcheck=1' ; \
        echo 'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-7' ; \
        echo ; \
        echo '[centos-sclo-rh]' ; \
        echo 'name=CentOS-7 - SCLo rh' ; \
        echo 'baseurl='"${CENTOS_MIRROR}"'/sclo/$basearch/rh/' ; \
        echo 'enabled=1' ; \
        echo 'gpgcheck=1' ; \
        echo 'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-SIG-SCLo' ; \
        echo ; \
        echo '[centos-sclo-sclo]' ; \
        echo 'name=CentOS-7 - SCLo sclo' ; \
        echo 'baseurl='"${CENTOS_MIRROR}"'/sclo/$basearch/sclo/' ; \
        echo 'enabled=1' ; \
        echo 'gpgcheck=1' ; \
        echo 'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-SIG-SCLo' ; \
        echo ; \
        echo '[epel]' ; \
        echo 'name=EPEL-7' ; \
        echo 'baseurl='"${EPEL_MIRROR}"'/$basearch/' ; \
        echo 'enabled=1' ; \
        echo 'gpgcheck=1' ; \
        echo 'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL-7' ; \
    } > /etc/yum.repos.d/centos7.repo ; \
    yum install -y \
        byacc cscope ctags diffstat elfutils flex gettext gettext-devel \
        glibc-static kernel-headers less m4 mpfr nettle patchutils perl-IPC-Cmd \
        perl-Time-Piece vim zip zstd \
        devtoolset-11-binutils devtoolset-11-gcc devtoolset-11-gcc-c++ \
        devtoolset-11-libstdc++-devel devtoolset-11-make

# gcc 11 from SCLo, the image defaults to devtoolset-10
ENV PATH="/opt/rh/devtoolset-11/root/usr/bin:/opt/php/bin:/opt/re2c/bin:/opt/nodejs/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/rh/devtoolset-11/root/usr/lib64:/opt/rh/devtoolset-11/root/usr/lib:/opt/rh/devtoolset-11/root/usr/lib64/dyninst:/opt/rh/devtoolset-11/root/usr/lib/dyninst:${LD_LIBRARY_PATH}"

# Build re2c, PHP CLI and unpack node
RUN --mount=type=cache,id=lwmbs-src-x86_64,target=/var/cache/lwmbs \
    set -xeo pipefail ; \
    mkdir -p /var/cache/lwmbs ; \
    curl -fsSL -o /var/cache/lwmbs/re2c.tar.xz \
        "https://github.com/skvadrik/re2c/releases/download/${RE2C_VERSION}/re2c-${RE2C_VERSION}.tar.xz" ; \
    mkdir -p /usr/src/re2c ; \
    tar -xf /var/cache/lwmbs/re2c.tar.xz --strip-components=1 -C /usr/src/re2c ; \
    cd /usr/src/re2c ; \
    ./configure --prefix=/opt/re2c ; \
    make -j "$(nproc)" ; \
    make install ; \
    curl -fsSL -o /var/cache/lwmbs/php.tar.xz \
        "https://www.php.net/distributions/php-${PHP_VERSION}.tar.xz" ; \
    mkdir -p /usr/src/php-src ; \
    tar -xf /var/cache/lwmbs/php.tar.xz --strip-components=1 -C /usr/src/php-src ; \
    cd /usr/src/php-src ; \
    ./configure \
        --prefix=/opt/php \
        --disable-all \
        --enable-cli ; \
    make -j "$(nproc)" ; \
    make install ; \
    curl -fsSL -o /var/cache/lwmbs/node.tar.xz \
        "https://unofficial-builds.nodejs.org/download/release/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64-glibc-217.tar.xz" ; \
    mkdir -p /opt/nodejs ; \
    tar -xf /var/cache/lwmbs/node.tar.xz --strip-components=1 -C /opt/nodejs ; \
    cd / ; \
    rm -rf /usr/src/re2c /usr/src/php-src

# Fail early if the toolchain is not the expected one
RUN set -xeo pipefail ; \
    test "$(gcc -dumpversion | cut -d. -f1)" -ge 11 ; \
    gcc --version | head -1 ; \
    php --version | head -1 ; \
    cmake --version | head -1 ; \
    re2c --version ; \
    node --version ; \
    npm --version

RUN git clone --branch $LWMBS_BRANCH $LWMBS_REPO /lwmbs

ENV LWMBS_CC=gcc
ENV LWMBS_CXX=g++

WORKDIR /

ENTRYPOINT []

CMD [ "/bin/bash" ]
